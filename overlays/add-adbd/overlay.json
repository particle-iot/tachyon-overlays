{
  "name": "add-adbd",
  "description": "Enable ADB over USB",
  "commands": [
    // Note - requires ubuntu particle debian repo to be added prior
    {
      "type": "chroot-cmd",
      "cmd": "apt install adbd"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/99-adbd-role-switch.rules",
      "destination": "/etc/udev/rules.d/99-adbd-role-switch.rules",
      "permissions": "644"
    }
  ]
}
