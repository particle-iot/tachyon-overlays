[Unit]
Description=Setup Qualcomm modem partitions and symlinks
After=local-fs.target dev-sdf8.device dev-sdg1.device
Wants=dev-sdf8.device dev-sdg1.device
Before=rmtfs.service ModemManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup-modem-symlinks.sh

[Install]
WantedBy=multi-user.target
