{
  "name": "fix-qcom-modem",
  "description": "Configures Qualcomm modem support with ModemManager, rmtfs, and partition setup",
  "commands": [
    // Install ModemManager and udev configs
    {
      "type": "chroot-script",
      "script": "install-configs.sh"
    },

    // Create modem mountpoints (created by add-fstab-mounts, but ensure they exist)
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /persist"
    },

    // Expose the modem firmware (core_nhlos_a, mounted at /vendor/modem) under
    // the path the kernel's request_firmware() searches, fixing the DSP/modem
    // remoteproc "request_firmware failed: -2" at boot.
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /lib/firmware/tachyon && ln -sf /vendor/modem /lib/firmware/tachyon/modem"
    },

    // Install modem setup script to /usr/local/bin
    {
      "type": "copy-into-chroot",
      "source": "create-modem-symlinks.sh",
      "destination": "/usr/local/bin/setup-modem-symlinks.sh",
      "permissions": "755"
    },

    // Install systemd service for modem setup
    {
      "type": "copy-into-chroot",
      "source": "files/particle-modem-setup.service",
      "destination": "/etc/systemd/system/particle-modem-setup.service",
      "permissions": "644"
    },

    // Install rmtfs if not already installed
    {
      "type": "chroot-cmd",
      "cmd": "dpkg -s rmtfs >/dev/null 2>&1 || apt-get install -y rmtfs"
    },

    // Install systemd service overrides
    {
      "type": "chroot-script",
      "script": "install-systemd-overrides.sh"
    },

    // Reload systemd daemon to pick up overrides
    {
      "type": "chroot-cmd",
      "cmd": "systemctl daemon-reload"
    },

    // Enable services
    {
      "type": "chroot-cmd",
      "cmd": "systemctl enable ModemManager"
    },
    {
      "type": "chroot-cmd",
      "cmd": "systemctl enable rmtfs"
    },
    {
      "type": "chroot-cmd",
      "cmd": "systemctl enable particle-modem-setup.service"
    }
  ]
}
