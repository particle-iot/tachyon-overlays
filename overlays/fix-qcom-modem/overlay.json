{
  "name": "fix-qcom-modem",
  "description": "Configures Qualcomm modem support with ModemManager, rmtfs, and partition setup",
  "commands": [
    // Install ModemManager and udev configs
    {
      "type": "chroot-script",
      "script": "install-configs.sh"
    },

    // Create modem mountpoints
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /persist /firmware"
    },

    // Add fstab entries for modem partitions
    {
      "type": "chroot-script",
      "script": "setup-fstab.sh"
    },

    // Set up /persist directory structure and permissions
    {
      "type": "chroot-cmd",
      "cmd": "chmod 755 /persist"
    },
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /persist/rmts"
    },
    {
      "type": "chroot-cmd",
      "cmd": "chmod 755 /persist/rmts"
    },

    // Create modem partition symlinks in /persist/rmts
    {
      "type": "chroot-script",
      "script": "create-modem-symlinks.sh"
    },

    // Install rmtfs if not already installed
    {
      "type": "chroot-cmd",
      "cmd": "dpkg -s rmtfs >/dev/null 2>&1 || apt-get install -y rmtfs"
    },

    // Install systemd service overrides
    {
      "type": "chroot-script",
      "script": "install-systemd-overrides.sh"
    },

    // Reload systemd daemon to pick up overrides
    {
      "type": "chroot-cmd",
      "cmd": "systemctl daemon-reload"
    },

    // Enable services
    {
      "type": "chroot-cmd",
      "cmd": "systemctl enable ModemManager"
    },
    {
      "type": "chroot-cmd",
      "cmd": "systemctl enable rmtfs"
    }
  ]
}
