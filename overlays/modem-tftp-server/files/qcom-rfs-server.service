# Qualcomm Remote File System Server
# Provides file-level access to Linux filesystem for Qualcomm modem subsystems (MPSS, ADSP, CDSP, SLPI)
# Uses QRTR (Qualcomm IPC Router) - not actual TFTP despite internal naming

[Unit]
Description=Qualcomm RFS (Remote File System) Server
DefaultDependencies=no
After=qrtr-ns.service particle-modem-setup.service
Wants=qrtr-ns.service

[Service]
Type=simple
ExecStart=/usr/sbin/qcom-rfs-server
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
