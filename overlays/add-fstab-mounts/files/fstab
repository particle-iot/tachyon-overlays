# Root filesystem
LABEL=   /            ext4  defaults,noatime,errors=remount-ro,commit=30  0  1

# Boot partition
LABEL=UEFI             /boot/efi    vfat  umask=0077                  0  1

# Qualcomm modem firmware partitions
PARTLABEL=modem_a      /vendor      vfat  defaults,ro,nofail,x-systemd.automount  0  0
PARTLABEL=bluetooth_a  /bt_firmware vfat  defaults,ro,nofail,x-systemd.automount  0  0

# Qualcomm modem data partitions
/dev/sdf8              /persist     ext4  rw,nosuid,nodev,noexec,noatime,nofail,x-systemd.automount  0  0
/dev/sdg1              /firmware    vfat  ro,nodev,noexec,relatime,nofail,x-systemd.automount        0  0
