# Root filesystem (cloud-image ext4 label)
LABEL=cloudimg-rootfs  /            ext4  defaults,noatime,errors=remount-ro,commit=30  0  1

# Qualcomm non-HLOS firmware (wlan / gpu / modem) lives on core_nhlos_a
PARTLABEL=core_nhlos_a /vendor      vfat  ro,nosuid,nodev,noexec,nofail  0  0

# Device-tree partition: on-demand automount so DT overlays can be edited live (sync flushes vs hard power-off)
PARTLABEL=dtb_a        /boot/dtb_a  vfat  rw,nofail,x-systemd.automount,sync  0  0

# Modem persist (NV) data
PARTLABEL=persist      /persist     ext4  rw,nosuid,nodev,noexec,noatime,nofail  0  0
