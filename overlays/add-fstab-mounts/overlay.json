{
  "name": "add-fstab-mounts",
  "description": "Install full fstab with all mount points and regenerate initramfs",
  "commands": [
    { "type": "chroot-cmd", "cmd": "mkdir -p /vendor /bt_firmware /boot/efi /persist /firmware" },
    { "type": "copy-into-chroot", "source": "files/fstab", "destination": "/etc/fstab", "permissions": "644" },
    { "type": "chroot-script", "script": "fix-fstab-label.sh" },
    { "type": "chroot-cmd", "cmd": "update-initramfs -k all -t -u" }
  ]
}