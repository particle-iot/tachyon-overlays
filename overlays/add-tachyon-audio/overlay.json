{
  "name": "add-tachyon-audio",
  "description": "Install Tachyon audio UCM2, WirePlumber policy, and tplg firmware",
  "commands": [
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /lib/firmware/qcom/qcm6490 /usr/share/alsa/ucm2/conf.d/qcm6490 /usr/share/alsa/ucm2/Qualcomm/qcm6490-tachyon /etc/wireplumber/main.lua.d"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/qcm6490-tachyon-snd-card-tplg.bin",
      "destination": "/lib/firmware/qcom/qcm6490/qcm6490-tachyon-snd-card-tplg.bin",
      "permissions": "644"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/qcm6490.conf",
      "destination": "/usr/share/alsa/ucm2/conf.d/qcm6490/qcm6490.conf",
      "permissions": "644"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/qcm6490-tachyon-snd-card.conf",
      "destination": "/usr/share/alsa/ucm2/conf.d/qcm6490/qcm6490-tachyon-snd-card.conf",
      "permissions": "644"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/HiFi.conf",
      "destination": "/usr/share/alsa/ucm2/Qualcomm/qcm6490-tachyon/HiFi.conf",
      "permissions": "644"
    },
    {
      "type": "copy-into-chroot",
      "source": "files/51-tachyon-audio.lua",
      "destination": "/etc/wireplumber/main.lua.d/51-tachyon-audio.lua",
      "permissions": "644"
    }
  ]
}
