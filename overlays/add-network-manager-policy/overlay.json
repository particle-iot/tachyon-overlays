{
    "name": "add-network-manager-policy",
    "description": "Adds polkit policy letting netdev users manage NetworkManager. JS .rules for all releases (24.04 + 26.04); legacy .pkla kept for 24.04, whose polkit still reads it via polkitd-pkla.",
    "commands": [
      {
        "type": "chroot-script",
        "script": "install-network-policy.sh"
      },
      // Copy via /tmp then cp inside the chroot: a direct copy-into-chroot to the
      // polkit dirs hits PermissionError: [Errno 13] on the mounted rootfs.
      {
        "type": "copy-into-chroot",
        "source": "files/99-network.pkla",
        "destination": "/tmp/99-network.pkla",
        "permissions": "644"
      },
      {
        "type": "copy-into-chroot",
        "source": "files/99-network.rules",
        "destination": "/tmp/99-network.rules",
        "permissions": "644"
      },
      {
        "type": "chroot-cmd",
        "cmd": "cp /tmp/99-network.pkla /etc/polkit-1/localauthority/90-mandatory.d/ && cp /tmp/99-network.rules /etc/polkit-1/rules.d/ && rm /tmp/99-network.pkla /tmp/99-network.rules"
      }
    ]
}
