{
  "name": "add-nm-connectivity-check",
  "description": "Pre-seeds NetworkManager's connectivity-check conf so particle-linux does not rewrite it and restart NetworkManager during first boot.",
  "commands": [
    // conf.d comes from the NetworkManager package (add-network-manager runs first),
    // but create it anyway so this overlay does not depend on that ordering.
    {
      "type": "chroot-cmd",
      "cmd": "mkdir -p /etc/NetworkManager/conf.d"
    },
    // The content must stay byte-identical to DESIRED_CONNECTIVITY_CONF in
    // particle-linux (src/daemon/InternetState.ts) -- including the
    // "# Autogenerated by particle-linux" header. particled compares the whole file
    // and, on any difference, rewrites it and restarts NetworkManager. Shipping a
    // "nicer" comment here would reintroduce exactly the restart this overlay exists
    // to avoid.
    {
      "type": "copy-into-chroot",
      "source": "files/20-connectivity.conf",
      "destination": "/etc/NetworkManager/conf.d/20-connectivity.conf",
      "permissions": "644"
    }
  ]
}
