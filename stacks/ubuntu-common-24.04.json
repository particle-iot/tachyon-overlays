//This file supports comments - they are stripped out before the JSON file is parsed
{
    "name": "ubuntu-common-24.04",
    "description": "Sets up the base system with required overlays and configurations.",
    "steps": [
      //NOTE:
      // Must stay ahead of every apt step. The 24.04 base pins its apt sources to one
      // AWS region's ports mirror (APT_MIRROR in tachyon-ubuntu-24.04 build.sh), and on
      // 2026-08-26 that pool degraded to 259 B/s with one backend in six a hard 503,
      // failing every composer build. Remove once the base image stops region-pinning.
      {
        "type": "overlay",
        "name": "use-generic-ubuntu-mirror"
      },
      {
        "type": "overlay",
        "name": "pin-pkg-versions"
      },
      {
        "type": "overlay",
        "name": "add-particle-repo"
      },
      {
        "type": "overlay",
        "name": "apt-upgrade"
      },
      {
        "type": "overlay",
        "name": "check-pinned-packages"
      },
      {
        "type": "overlay",
        "name": "add-led-battery-charging-rules"
      },
      {
        "type": "overlay",
        "name": "raise-usb-input-current-limit"
      },
      {
        "type": "overlay",
        "name": "root-passwd"
      },
      {
        "type": "overlay",
        "name": "add-root-ssh"
      },
      // {
      //   "type": "overlay",
      //   "name": "configure-logs"
      // },
      // {
      //   "type": "overlay",
      //   "name": "add-speedtest"
      // },
      {
        "type": "overlay",
        "name": "add-gpio-tools"
      },
      {
        "type": "overlay",
        "name": "particle-service"
      },
      {
        "type": "overlay",
        "name": "set-initial-time"
      },
      {
        "type": "overlay",
        "name": "particle-tachyon-deb"
      },
      {
        "type": "overlay",
        "name": "configure-unattended-upgrade"
      },
      {
        "type": "overlay",
        "name": "add-network-manager"
      },
      // Ships NetworkManager's connectivity-check conf so particle-linux finds it
      // already correct and skips its rewrite-and-restart on first boot. Must come
      // after add-network-manager, which installs NetworkManager itself.
      {
        "type": "overlay",
        "name": "add-nm-connectivity-check"
      },
      {
        "type": "overlay",
        "name": "add-tailscale"
      },
      {
        "type": "overlay",
        "name": "set-adb-env-vars"
      },
      // {
      //   "type": "overlay",
      //   "name": "remove-dhcpcd"
      // },
      // {
      //   "type": "overlay",
      //   "name": "remove-unnecessary-packages"
      // },
      {
        "type": "overlay",
        "name": "add-docker"
      },
      {
        "type": "overlay",
        "name": "add-perf-utils"
      },
      {
        "type": "overlay",
        "name": "add-cpu-governor-default"
      },
      {
        "type": "overlay",
        "name": "add-particle-user"
      },
      // {
      //   "type": "overlay",
      //   "name": "add-autologin-getty"
      // },
      // {
      //   "type": "overlay",
      //   "name": "add-particle-user-extra-groups"
      // },
      {
        "type": "overlay",
        "name": "add-particle-cli"
      },
      //The Kigen LPA (eSIM local profile assistant) -> /usr/bin/lpa. Present on 20.04
      //via ubuntu-common-20.04 but never wired into any 24.04 stack, so /usr/bin/lpa
      //has been missing from every 24.04 image.
      //Requires tachyon-composer to stage $RESOURCES/lpa-linux-arm64 (composer#70) --
      //the binary lives in a private repo and the overlay container has no credentials.
      {
        "type": "overlay",
        "name": "add-kigen-sdk"
      },
      {
        "type": "overlay",
        "name": "minimum-swap"
      },
      {
        "type": "overlay",
        "name": "add-systemd-suspend-hooks"
      },
      {
        "type": "overlay",
        "name": "add-tachyon-firmware-pkg"
      },
      {
        "type": "overlay",
        "name": "add-adbd"
      },
      {
        "type": "overlay",
        "name": "add-fstab-mounts"
      },
      // Firmware/audio overlays for the current (new-BP) layout.
      {
        "type": "overlay",
        "name": "add-qcm6490-bp-fw"
      },
      {
        "type": "overlay",
        "name": "link-ath11k-firmware"
      },
      {
        "type": "overlay",
        "name": "link-qca-bt-firmware"
      },
      {
        "type": "overlay",
        "name": "add-gpu-firmware"
      },
      {
        "type": "overlay",
        "name": "add-video-firmware"
      },
      {
        "type": "overlay",
        "name": "add-tachyon-audio"
      },
      {
        "type": "overlay",
        "name": "fix-qcom-modem"
      },
      // New-BP (1.2+) only: expose modem firmware under the kernel's request_firmware() path.
      {
        "type": "overlay",
        "name": "link-modem-firmware"
      },
      {
        "type": "overlay",
        "name": "modem-tftp-server"
      },
      // Both variants only have two antennas, so 4x4 MIMO has to come off; NA
      // additionally runs at reduced TX power for FCC.
      {
        "type": "overlay",
        "name": "modem-rf-config"
      },
      {
        "type": "overlay",
        "name": "add-grub-configuration"
      },
      {
        "type": "overlay",
        "name": "growfs"
      },
      {
        "type": "overlay",
        "name": "disable-wait-online-service"
      },
      {
        "type": "overlay",
        "name": "add-network-manager-policy"
      },
      {
        "type": "overlay",
        "name": "add-linux-tools"
      },
      {
        "type": "overlay",
        "name": "add-camera-support"
      },
      {
        "type": "overlay",
        "name": "add-tee-support"
      },
      {
        "type": "overlay",
        "name": "add-msm-blacklist"
      },
      {
        "type": "overlay",
        "name": "add-particle-version"
      }
    ]
  }
  