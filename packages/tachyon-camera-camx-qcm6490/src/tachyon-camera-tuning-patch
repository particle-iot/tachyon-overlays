#!/usr/bin/env python3
"""Stop auto-exposure oscillating in the shipped IMX519 tuning binary.

The borrowed vendor tuning makes AE hunt, which reads as flicker in video
(luma peak-to-peak 13-15 of 255):

  tolMultUnitStepSize 2 -> 5   (Convergence.xml, fastConv)
      Tolerance for deciding the scene really changed. At 2, noise crosses it.

  DFSExpIndexTolerance 1.0 -> 5.0   (aecSkipCtrl.xml)
      Tolerance for calling AE settled. Below it AE keeps trimming in a
      ~3-frame oscillation; 3.0 still did so in some light (A/B: 102 jumps
      in 300 frames at 3.0, 0 at 5.0).

  aggressiveness 0.8 -> 0.4   (Convergence.xml, fastConv)
      Share of the remaining error corrected per update. Halved so the
      brightness change when someone walks past is gradual, not a jump.

Result: peak-to-peak 0.3-0.6, AE still tracking light (EV -6/0/+6 -> 85/126/163).

Patched in place because the tuning cannot be regenerated: rebuilding it from
the r108 project drops 71 modules and CamX core-dumps on the result. CamX also
checks a CRC32 of the body held in the last four bytes -- a mismatch silently
enumerates zero cameras -- so it is recomputed here.

Idempotent and all-or-nothing: every byte is checked against its stock value,
so a different tuning drop is left alone rather than corrupted.
"""

import os
import struct
import sys
import zlib

TUNING = "/usr/lib/qcm6490/camera/com.qti.tuned.sunny_imx519.bin"

# Offsets found by building the tuning project twice with ParameterParser
# V5.5.1 (r108 SDK, chi-cdk-kt) changing one value at a time and diffing.
# They are specific to the file this package ships; the checks below refuse
# to guess on anything else.
#
#   (offset, stock bytes, wanted bytes, name)
EDITS = [
    (355330, b"\x02",     b"\x05",     "tolMultUnitStepSize 2 -> 5"),
    (355340, b"\x4c\x3f", b"\xcc\x3e", "aggressiveness 0.8 -> 0.4"),
    (361401, b"\x80\x3f", b"\xa0\x40", "DFSExpIndexTolerance 1.0 -> 5.0"),
]
EXPECT_SIZE = 1294982


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else TUNING
    try:
        with open(path, "rb") as f:
            data = bytearray(f.read())
    except OSError as e:
        print("tuning-patch: cannot read %s (%s), skipping" % (path, e))
        return 0

    if len(data) != EXPECT_SIZE:
        print("tuning-patch: %s is %d bytes, expected %d -- different tuning "
              "drop, leaving it alone" % (path, len(data), EXPECT_SIZE))
        return 0

    stored = bytes(data[-4:])
    actual = struct.pack("<I", zlib.crc32(bytes(data[:-4])) & 0xFFFFFFFF)
    if stored != actual:
        print("tuning-patch: CRC mismatch in %s (stored %s, computed %s) -- "
              "not touching it" % (path, stored.hex(), actual.hex()))
        return 0

    todo = []
    for off, stock, wanted, name in EDITS:
        have = bytes(data[off:off + len(stock)])
        if have == wanted:
            continue                       # already applied
        if have != stock:
            print("tuning-patch: bytes at %d are %s, expected the stock %s -- "
                  "layout changed, leaving the file alone"
                  % (off, have.hex(), stock.hex()))
            return 0                       # all or nothing: never half-patch
        todo.append((off, wanted, name))

    if not todo:
        print("tuning-patch: already applied, nothing to do")
        return 0

    for off, wanted, name in todo:
        data[off:off + len(wanted)] = wanted
    data[-4:] = struct.pack("<I", zlib.crc32(bytes(data[:-4])) & 0xFFFFFFFF)

    # Write beside the original and rename, so an interrupted install cannot
    # leave a half-written tuning that CamX would refuse.
    tmp = path + ".patch.tmp"
    with open(tmp, "wb") as f:
        f.write(bytes(data))
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    for _, _, name in todo:
        print("tuning-patch: %s" % name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
