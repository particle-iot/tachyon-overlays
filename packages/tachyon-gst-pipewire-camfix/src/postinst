#!/bin/sh
# Put the patched plugin in front of the distribution's copy.
#
# dpkg-divert rather than overwriting: the file belongs to
# gstreamer1.0-pipewire, and without a diversion the next upgrade of that
# package silently replaces it and the crash comes back with nothing to show
# why. With one, dpkg moves the distribution's file aside and knows this
# package owns the path, so upgrades of either side stay consistent and
# removing this package restores the original.
set -e

PLUGIN=/usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstpipewire.so
DIVERT="$PLUGIN.distrib"

case "$1" in
configure)
    dpkg-divert --package tachyon-gst-pipewire-camfix --add --rename \
        --divert "$DIVERT" "$PLUGIN" >/dev/null 2>&1 || true

    install -m 644 /usr/share/tachyon-gst-pipewire-camfix/libgstpipewire.so "$PLUGIN"

    # GStreamer caches the plugin registry per user and keys it on mtime and
    # size. Both change here, so it would normally re-scan - but a stale cache
    # written while the old plugin was in place has been seen to survive, and
    # a stale entry means the old behaviour with no sign of it.
    rm -f /root/.cache/gstreamer-1.0/registry.*.bin 2>/dev/null || true
    for home in /home/*; do
        [ -d "$home/.cache/gstreamer-1.0" ] || continue
        rm -f "$home"/.cache/gstreamer-1.0/registry.*.bin 2>/dev/null || true
    done
    ;;
esac

exit 0
